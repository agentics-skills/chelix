# Copy to .envrc and fill in your values, then run `direnv allow`.
# Variables use the CHELIX_<SECTION>__<FIELD> override convention
# which maps directly to chelix.toml config sections.

# ── Identity (skip onboarding name prompts) ──────────────────────
export CHELIX_IDENTITY__NAME="chelix"          # bot display name
export CHELIX_IDENTITY__EMOJI=""               # bot emoji
export CHELIX_USER__NAME=""                    # your name

# ── LLM provider ─────────────────────────────────────────────────
# Named OpenAI Compatible section. Models stay in chelix.toml.
export CHELIX_PROVIDERS__EXAMPLE__API_KEY=""
export CHELIX_PROVIDERS__EXAMPLE__BASE_URL="https://api.example.invalid/v1"

# ── Voice: TTS ───────────────────────────────────────────────────
export ELEVENLABS_API_KEY=""
# export CHELIX_VOICE__TTS__PROVIDER="elevenlabs"
# export CHELIX_VOICE__TTS__ELEVENLABS__VOICE_ID=""

# ── Voice: STT ───────────────────────────────────────────────────
export DEEPGRAM_API_KEY=""
# export CHELIX_VOICE__STT__PROVIDER="deepgram"   # default is "whisper" (local)

